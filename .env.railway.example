# Railway service variables 範本 —— 複製成 .env.railway 填入真實值後
# 用 scripts/provision.sh 套用，或直接貼進 Railway dashboard。
#
# ⚠️ .env.railway 已被 .gitignore 排除。不要把真實密鑰 commit 進來。
#
# ⚠️ 憑證管理紀律（見 plan/04 §2）：
#    $HERMES_HOME/.env 是以 override=True 載入的，會「蓋掉」Railway 注入的
#    環境變數。所以：
#      - 不要在容器內跑 `hermes setup`（會把 API key 寫進 .env）
#      - 不要用 `hermes config set <某個 API_KEY>`（同樣路由到 .env）
#      - `hermes config set` 只用於非憑證設定（model / terminal.backend / ...）
#    唯一無解的例外是 API_SERVER_KEY —— stage2-hook.sh 一定會自動產生一組寫進
#    .env。因為 api_server 維持 loopback、不對外可達，接受即可。

# ── Railway 執行期 ────────────────────────────────────────────────────
# volume 以 root 掛載；stage2-hook.sh 需要 root 才能做 UID remap 與 chown，
# 之後每個受監管服務再用 s6-setuidgid 降權到 hermes(UID 10000)。
RAILWAY_RUN_UID=0
PORT=9119
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_TIMEZONE=Asia/Taipei

# ⚠️ 不可省。全新 volume 上沒有 gateway_state.json，02-reconcile-profiles
#    只會註冊 s6 slot 而「不會啟動」gateway —— 代理人不會連 Telegram、
#    cron 不會跑。這個變數讓 stage2 在首次開機寫下 {"gateway_state":"running"}。
HERMES_GATEWAY_BOOTSTRAP_STATE=running

# ── Dashboard 驗證：Auth0（Google 當 social connection）──────────────
# 設定步驟見 plan/07 §5。重點：
#   - Auth0 Application 的 Allowed Callback URLs = https://hermes.relvo.cc/auth/callback
#   - Application 的 Connections 只勾 Google，關閉 Database connection
#   - post-login Action 做 email 白名單 + email_verified 檢查
#   - Google OAuth client 的 redirect URI 是 Auth0 的 /login/callback，不是 Hermes 的
HERMES_DASHBOARD_OIDC_ISSUER=https://<tenant>.<region>.auth0.com/
HERMES_DASHBOARD_OIDC_CLIENT_ID=
HERMES_DASHBOARD_OIDC_CLIENT_SECRET=

# 選配：要靜默續期才加 offline_access。預設 scopes 不含它 → Auth0 不發
# refresh token → ID token 到期（Auth0 預設 10h）就要重新登入。
# Auth0 端也要在 Advanced Settings → Grant Types 勾選 Refresh Token。
# HERMES_DASHBOARD_OIDC_SCOPES=openid profile email offline_access

# ⚠️ 自訂網域下必填。不能依賴 RAILWAY_PUBLIC_DOMAIN 推導 —— 掛了自訂網域後
#    它取哪個值 Railway 沒有文件說明；若仍是 *.up.railway.app，OAuth callback
#    會被組成錯的 host，Auth0 直接回 redirect_uri_mismatch。
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.relvo.cc

# ── Model provider ────────────────────────────────────────────────────
# 本機執行 `claude setup-token` 產生。Hermes 原生支援 Claude Code 憑證：
# provider: anthropic 接受 ANTHROPIC_API_KEY 或 CLAUDE_CODE_OAUTH_TOKEN，
# 且憑證解析優先採用可刷新的 Claude Code credentials。
CLAUDE_CODE_OAUTH_TOKEN=

# 備援 provider 的 key。Claude Code 訂閱是滾動時間窗限額、設計前提是互動式
# 使用；而這是常駐 gateway + Telegram + cron + 學習迴圈的無人值守負載，
# 撞頂機率高。撞頂後代理人會整段啞掉。
# fallback_providers 本身住在 config.yaml，見下方 HERMES_BOOTSTRAP_CONFIG 說明。
OPENROUTER_API_KEY=

# ── 首次開機的 config bootstrap（本專案自訂）──────────────────────────
# 只在 /opt/data/.railway_bootstrapped 不存在時生效，之後不覆蓋手動調整。
HERMES_BOOTSTRAP_MODEL=anthropic/<claude-model-id>
HERMES_BOOTSTRAP_TERMINAL_BACKEND=local

# 自由形式的額外 config.yaml 設定，一行一個 key=value，透過 `hermes config set`
# 套用。tool_loop_guardrails 是官方建議無人值守部署要開的斷路器（預設關閉，
# 只適合有人盯著的互動式 session）。
HERMES_BOOTSTRAP_CONFIG="tool_loop_guardrails.hard_stop_enabled=true
tool_loop_guardrails.hard_stop_after.exact_failure=5
tool_loop_guardrails.hard_stop_after.idempotent_no_progress=5"

# ── 訊息平台 ──────────────────────────────────────────────────────────
# polling 是預設模式，不佔對外埠。掛了 volume 的 Railway service 不會
# scale to zero，所以 polling「機器無法休眠」的缺點在此不成立。
TELEGRAM_BOT_TOKEN=

# ── 瀏覽器工具 ────────────────────────────────────────────────────────
# AGENT_BROWSER_ARGS 由 016-railway-bootstrap 自動設為
# --no-sandbox,--disable-dev-shm-usage，通常不用手設。
# 設 HERMES_RAILWAY_BROWSER_ARGS=0 可停用該段（例如改用雲端瀏覽器時）。
#
# 若本地 Chromium 在 Railway 上不穩，改用雲端瀏覽器：
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# ── 刻意不設 ──────────────────────────────────────────────────────────
# API_SERVER_ENABLED / API_SERVER_HOST —— api_server 維持 loopback
#   (127.0.0.1:8642)。它提供代理人的完整工具集「包含 terminal 指令執行」，
#   正是 2026 年 6 月那波攻擊的入口之一。
# HERMES_ALLOWLIST_* —— 那是 plan/07 附錄 A 未採用的自寫 plugin 路線；
#   白名單走 Auth0，用 bundled 的 self_hosted provider 即可。
# HERMES_GATEWAY_NO_SUPERVISE —— 設了會退回「gateway 就是容器主程序」的
#   舊語意，失去 s6 的自動重啟。
